# Copy to .env.local and fill in. Both vars MUST be prefixed with VITE_ so
# Vite exposes them to the client bundle.
#
# Setup: docs/cloud-setup.md (create a private gist + a fine-grained
# Gists-only PAT). Without both vars set, the cloud Save / Load is
# hidden and the app runs as a local-only tool.

VITE_GIST_ID=YOUR-GIST-ID-HERE
VITE_GIST_TOKEN=github_pat_YOUR-TOKEN-HERE

# Admin PIN — when set, non-admins see only the read-only schedule
# (no hours, no edit controls). Anyone with the JS bundle can grep the
# value, so this is UX-level gating, not real auth. Leave empty to run
# fully unlocked (everyone is admin). Use whatever digit count you
# like; any non-empty string works.
VITE_ADMIN_PIN=
