# Copy to .env.local and fill in. Both vars MUST be prefixed with VITE_ so
# Vite exposes them to the client bundle. The anon key is public by design
# (it's embedded in the JS); RLS policies on the `schedules` table are what
# actually gate read/write access.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY-HERE
